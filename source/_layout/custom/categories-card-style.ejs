/* 整体页面布局 */
.custom-categories-page .main-inner {
  max-width: 1200px;
  padding: 0 20px;
  margin: 0 auto;
}

/* 横幅图片 */
.banner-img {
  margin-bottom: 3rem;
  border-radius: 12px;
  overflow: hidden;
  
  img {
    width: 100%;
    height: auto;
    max-height: 300px;
    object-fit: cover;
  }
}

/* 卡片网格布局 */
.custom-categories-grid {
  display: grid;
  gap: 2rem;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  padding: 2rem 0;
}

/* 卡片容器 */
.category-card {
  display: block;
  height: 400px;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 3px 10px rgba(0,0,0,.05);
  transition: all .4s cubic-bezier(.4,0,.2,1);
  position: relative;
}

.category-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 25px rgba(0,0,0,.1);
}

/* 封面容器（保持比例） */
.card-cover-wrap {
  height: 75%;
  overflow: hidden;
  position: relative;
}

.card-cover-wrap::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  background: linear-gradient(transparent 40%, rgba(0,0,0,.7));
  z-index: 1;
}

.card-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .8s ease;
}

.category-card:hover .card-cover {
  transform: scale(1.05);
}

/* 文字内容区 */
.card-content {
  padding: 1.2rem;
  position: relative;
  z-index: 2;
}

.card-title {
  font-size: 1.8rem;
  margin: 0 0 0.5rem 0;
  color: #fff;
  text-shadow: 0 2px 4px rgba(0,0,0,.3);
}

.card-description {
  color: rgba(255,255,255,.9);
  font-size: 1rem;
  margin-bottom: 0.5rem;
}

.card-meta {
  color: rgba(255,255,255,.8);
  font-size: .9rem;
}

/* 响应式调整 */
@media (max-width: 768px) {
  .custom-categories-grid {
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  
  .category-card {
    height: 350px;
  }
}

@media (max-width: 480px) {
  .custom-categories-grid {
    grid-template-columns: 1fr;
  }
  
  .category-card {
    height: 320px;
  }
  
  .card-cover-wrap {
    height: 70%;
  }
}